{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "turn_id": {
        "type": "string",
        "pattern": "^[1-9]$"
      },
      "key": {
        "enum": [
          "project_understanding",
          "technical_reasoning",
          "problem_solving",
          "communication",
          "contribution_clarity",
          "company_job_fit"
        ]
      },
      "level": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          "not_applicable"
        ]
      },
      "acceptable": {
        "type": "array",
        "items": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            "not_applicable"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "rationale": {
        "type": "string",
        "pattern": "\\S"
      },
      "rubric_quote": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "required": [
      "turn_id",
      "key",
      "level",
      "rationale"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "level": {
              "const": "not_applicable"
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "rubric_quote"
            ]
          }
        },
        "else": {
          "required": [
            "rubric_quote"
          ]
        }
      }
    ]
  },
  "minItems": 1
}
